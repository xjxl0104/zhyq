# 智慧园区后端环境变量示例(复制为 .env 并填真实值,.env 不得提交)
# 数据库(库名与 docker-compose.full.yml 保持 zhyq_park;本机裸跑按需改端口)
DB_URL=jdbc:mysql://localhost:3306/zhyq_park?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_NAME=zhyq_park
DB_USERNAME=root
DB_PASSWORD=
DB_ROOT_PASSWORD=

# JWT(HS256 密钥,生产必须填,建议 >=32 字节随机串)
JWT_SECRET=
JWT_EXPIRE_SECONDS=28800

# 密码登录限速：反代部署填可信代理 IP/CIDR，逗号分隔；直连部署留空。
# 仅信任被核验且无法由公网冒充的代理；同时保持 server.forward-headers-strategy=none。
# 多跳 Caddy -> Nginx -> backend 必须配置 Caddy 和 Nginx 两个实际对端。
ZHYQ_AUTH_TRUSTED_PROXIES=

# 敏感字段加密密钥(Base64 编码的 32 字节随机值;新变量优先,旧变量仅兼容升级)
ZHYQ_FIELD_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY=

# 自动售货机厂商入口(仅作为受控 HTTPS 外链，不携带园区 token)
VENDING_EXTERNAL_URL=https://fanmaiji.top/index?isFrom=login

# 接口文档(生产建议 false)
SWAGGER_ENABLED=false

# CORS 允许来源(逗号分隔,生产收紧到正式域名)
CORS_ALLOWED_ORIGINS=

# 上传目录与端口
UPLOAD_PATH=./uploads
HTTP_PORT=18080
