# 智慧园区后端环境变量示例(复制为 .env 并填真实值,.env 不得提交)
# 数据库(库名与 docker-compose.full.yml 保持 zhyq_park;本机裸跑按需改端口)
DB_URL=jdbc:mysql://localhost:3306/zhyq_park?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_NAME=zhyq_park
DB_USERNAME=root
DB_PASSWORD=
DB_ROOT_PASSWORD=

# JWT(HS256 密钥,生产必须填,建议 >=32 字节随机串)
JWT_SECRET=
JWT_EXPIRE_SECONDS=28800

# 敏感字段加密密钥
APP_ENCRYPTION_KEY=

# 接口文档(生产建议 false)
SWAGGER_ENABLED=false

# CORS 允许来源(逗号分隔,生产收紧到正式域名)
CORS_ALLOWED_ORIGINS=

# 上传目录与端口
UPLOAD_PATH=./uploads
HTTP_PORT=18080
